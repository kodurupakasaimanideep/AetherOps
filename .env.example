# AetherOps AI - Environment Configuration Template
# Populate these variables for live Microsoft Azure and Gemini AI integrations.

# Microsoft Azure & Entra ID (Azure AD) Credentials
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-log-analytics-workspace-id-here

# AI Service Configuration
GEMINI_API_KEY=your-gemini-api-key-here
FLASK_ENV=production
PORT=5000
